<% layout("/layouts/boilerplate") %>

<div class="error-page">
  <div class="error-card text-center">
    <div class="error-icon">
      <% if (err.statusCode === 404) { %>
        <i class="fa-solid fa-map-location-dot fa-4x" style="color:#fe424d;"></i>
      <% } else { %>
        <i class="fa-solid fa-triangle-exclamation fa-4x" style="color:#fe424d;"></i>
      <% } %>
    </div>
    <h1 class="error-code"><%= err.statusCode || 500 %></h1>
    <h4 class="mb-2"><%= err.message || "Something went wrong!" %></h4>
    <p class="text-muted mb-4">
      <% if (err.statusCode === 404) { %>
        The page you're looking for doesn't exist or has been moved.
      <% } else { %>
        An unexpected error occurred. Please try again later.
      <% } %>
    </p>
    <a href="/listings" class="btn add-btn text-white px-4">
      <i class="fa-solid fa-house me-2"></i>Back to Home
    </a>
  </div>
</div>
