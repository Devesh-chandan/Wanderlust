<style>
  .navbar-brand-text {
    font-weight: 700;
    font-size: 1.25rem;
    color: #222 !important;
    letter-spacing: -0.5px;
  }

  .navbar-brand-text span {
    color: #fe424d;
  }

  .search-container {
    position: relative;
    max-width: 420px;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-input {
    border-radius: 30px !important;
    padding-left: 1.2rem !important;
    padding-right: 3.5rem !important;
    height: 2.8rem;
    border: 1px solid #ddd;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    font-size: 0.88rem;
    transition: all 0.2s ease;
    width: 100%;
  }

  .search-input:focus {
    border-color: #fe424d;
    box-shadow: 0 4px 14px rgba(254, 66, 77, 0.15);
  }

  .btn-search {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    background-color: #fe424d !important;
    color: #ffffff !important;
    border-radius: 50% !important;
    width: 2.2rem !important;
    height: 2.2rem !important;
    min-width: 2.2rem !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    cursor: pointer;
    z-index: 10;
    box-shadow: 0 2px 6px rgba(254, 66, 77, 0.4);
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-search i {
    font-size: 0.9rem !important;
    color: #ffffff !important;
  }

  .btn-search:hover {
    background-color: #e03040 !important;
    color: #ffffff !important;
    transform: translateY(-50%) scale(1.06);
  }

  .user-badge {
    background: linear-gradient(135deg, #fe424d, #ff7b5a);
    color: white;
    border-radius: 50px;
    padding: 0.35rem 0.95rem;
    font-size: 0.82rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .host-home-btn {
    background-color: #ffffff;
    color: #222222 !important;
    border: 1px solid #e0e0e0;
    border-radius: 30px;
    padding: 0.45rem 1.1rem !important;
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none !important;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    transition: all 0.25s ease;
  }

  .host-home-btn i {
    color: #fe424d;
    font-size: 0.95rem;
    transition: transform 0.2s ease;
  }

  .host-home-btn:hover {
    background-color: #fff5f5;
    border-color: #fe424d;
    color: #fe424d !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(254, 66, 77, 0.15);
  }

  .host-home-btn:hover i {
    transform: scale(1.15) rotate(-5deg);
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/listings">
      <i class="fa-regular fa-compass" style="color:#fe424d; font-size:2rem;"></i>
      <span class="navbar-brand-text">Wander<span>lust</span></span>
    </a>

    <!-- Mobile toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
      aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">

      <!-- Left nav -->
      <ul class="navbar-nav me-auto mb-2 mb-md-0">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Explore</a>
        </li>
      </ul>

      <!-- Enhanced Search Bar (Center) -->
      <form class="d-flex mx-auto search-container" action="/listings" method="GET">
        <input class="form-control search-input" type="search" name="q"
          placeholder="Search destinations, villas, beaches..." aria-label="Search"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />
        <button class="btn btn-search" type="submit" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- Right nav -->
      <ul class="navbar-nav ms-auto mb-2 mb-md-0 align-items-md-center gap-2">
        <li class="nav-item me-1">
          <a class="nav-link host-home-btn" href="/listings/new">
            <i class="fa-solid fa-house-user"></i>
            <span>Host Your Space</span>
          </a>
        </li>

        <% if (!currUsers) { %>
          <li class="nav-item">
            <a class="nav-link" href="/signup"><b>Sign Up</b></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login"><b>Log In</b></a>
          </li>
          <% } else { %>
            <li class="nav-item d-flex align-items-center">
              <span class="user-badge me-2">
                <i class="fa-solid fa-user-circle"></i>
                <%= currUsers.username %>
              </span>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">
                <i class="fa-solid fa-right-from-bracket me-1"></i>Log Out
              </a>
            </li>
            <% } %>
      </ul>

    </div>
  </div>
</nav>